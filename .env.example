# KKU SSONext credentials — copy this file to .env and fill in the real
# values you received from KKU. Never commit the real .env.

# Full token-exchange endpoint URL (KKU gave this as a complete URL, e.g.
# https://ssonext-api.kku.ac.th/auth.token, or the UAT equivalent) — NOT
# just a base host.
OAUTH_ISSUER=

OAUTH_APP_ID=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URL registered with KKU when the App ID
# was issued (e.g. https://odt-stvascan.kku.ac.th/callback in production).
OAUTH_REDIRECT_URI=

# Login/logout web host — MUST be the same environment (UAT vs production)
# as OAUTH_ISSUER's host, or KKU rejects it with "Cannot find the CREDENTIAL":
#   production: https://ssonext.kku.ac.th     (pairs with ssonext-api.kku.ac.th)
#   UAT:        https://sso-uat-web.kku.ac.th (pairs with sso-uat-api.kku.ac.th)
# Defaults to the production value if left blank.
OAUTH_LOGIN_BASE=

# Comma-separated allowlist of emails permitted to log in (case-insensitive).
# Leave empty to allow anyone who can authenticate via KKU SSO.
ALLOWED_EMAILS=

# AI Gateway defaults — used only as fallback values when a user connects
# their own key at /ai-key without specifying a base URL/model. There is no
# shared/global API key: each logged-in user brings their own (see
# `user_ai_keys` table / the "🔌 AI ของฉัน" page), so the "🤖 สรุปด้วย AI"
# button is per-user, not controlled by this file.
KKU_AI_BASE_URL=https://gen.ai.kku.ac.th
KKU_AI_MODEL=claude-sonnet-5
AI_SUMMARY_CONTACT_EMAIL=
